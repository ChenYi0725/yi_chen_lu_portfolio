{
  "version": 2,
  "builds": [
    {
      "src": "build/web/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "build/web/assets/$1" },
    { "src": "/favicon.png", "dest": "build/web/favicon.png" },
    { "src": "/manifest.json", "dest": "build/web/manifest.json" },
    { "src": "/flutter.js", "dest": "build/web/flutter.js" },
    { "src": "/flutter_bootstrap.js", "dest": "build/web/flutter_bootstrap.js" },
    { "src": "/main.dart.js", "dest": "build/web/main.dart.js" },
    { "src": "/flutter_service_worker.js", "dest": "build/web/flutter_service_worker.js" },
    {
      "src": "/(.*)",
      "dest": "build/web/index.html"
    },
    { "src": "/api/(.*)", "dest": "/api/$1" }
  ]

}
